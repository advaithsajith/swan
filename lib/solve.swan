--- Solving equations: straight lines, quadratics, pairs of equations and anything by bisection.
--- Bring it in with:  use solve   (then solve.quadratic(1, -3, 2))
--- or pick a few:     use quadratic, root from solve


-- ── checking what we were given ─────────────────────────

hidden fn numbers(what, ...values)
    for v in values
        if not (v is number)
            fail "{what} needs numbers, but got {type(v)}."

hidden fn tidy(x)
    let r = round(x, 10)
    if r == floor(r) then return floor(r)
    r


-- ── one unknown ─────────────────────────────────────────

--- Solves a × x + b = 0 for x: linear(2, -6) is 3
fn linear(a, b)
    numbers("linear", a, b)
    if a == 0
        fail "linear can't solve this: with a = 0 there's no x in the equation."
    tidy(-b / a)

--- The real roots of a × x² + b × x + c = 0, smallest first. There may be two, one or none.
fn quadratic(a, b, c)
    numbers("quadratic", a, b, c)
    if a == 0
        fail "quadratic needs a to be something other than 0. For b × x + c = 0, use linear(b, c)."
    let inside = b * b - 4 * a * c
    if inside < 0 then return []
    if inside == 0 then return [tidy(-b / (2 * a))]
    let r = sqrt(inside)
    sort([tidy((-b - r) / (2 * a)), tidy((-b + r) / (2 * a))])

--- Solves a / b = c / x for the missing x: proportion(2, 3, 8) is 12
fn proportion(a, b, c)
    numbers("proportion", a, b, c)
    if a == 0
        fail "proportion can't work with a = 0: there's no number x that makes 0 / {b} = {c} / x."
    tidy(b * c / a)


-- ── two unknowns ────────────────────────────────────────

--- Solves two equations at once: a1 × x + b1 × y = c1 and a2 × x + b2 × y = c2. Gives back [x, y].
fn simultaneous(a1, b1, c1, a2, b2, c2)
    numbers("simultaneous", a1, b1, c1, a2, b2, c2)
    let d = a1 * b2 - a2 * b1
    if d == 0
        fail "simultaneous found no single answer: the two equations are parallel lines (or the same line)."
    [tidy((c1 * b2 - c2 * b1) / d), tidy((a1 * c2 - a2 * c1) / d)]


-- ── any function ────────────────────────────────────────

--- Finds an x between low and high where f(x) is 0, by halving the gap again and again.
--- f(low) and f(high) must have opposite signs, so the function crosses zero somewhere between.
fn root(f, low, high, precision = 0.0000000001)
    numbers("root", low, high, precision)
    if not (f is function)
        fail "root needs a function to solve, like: root(x => x * x - 2, 0, 2)"
    var a = min(low, high)
    var b = max(low, high)
    var fa = f(a)
    if fa == 0 then return a
    if f(b) == 0 then return b
    if (fa < 0) == (f(b) < 0)
        fail "root needs f(low) and f(high) to have opposite signs, so a zero lies between them. f({a}) and f({b}) don't."
    repeat 200
        let mid = (a + b) / 2
        let fm = f(mid)
        if fm == 0 or b - a < precision then return tidy(mid)
        if (fm < 0) == (fa < 0)
            a, fa = mid, fm
        else
            b = mid
    tidy((a + b) / 2)


test "one unknown"
    expect linear(2, -6) == 3
    expect linear(4, 2) == -0.5
    expect quadratic(1, -3, 2) == [1, 2]
    expect quadratic(1, 2, 1) == [-1]
    expect quadratic(1, 0, 1) == []
    expect quadratic(2, -4, -6) == [-1, 3]
    expect proportion(2, 3, 8) == 12

test "two unknowns"
    expect simultaneous(1, 1, 5, 1, -1, 1) == [3, 2]
    expect simultaneous(2, 3, 12, 1, -1, 1) == [3, 2]

test "any function"
    expect round(root(x => x * x - 2, 0, 2), 6) == round(sqrt(2), 6)
    expect root(x => x - 4, 0, 10) == 4
    expect root(x => x ** 3 - 27, 10, 0) == 3
