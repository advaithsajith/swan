{
  "name": "swan-language",
  "displayName": "Swan",
  "description": "Colours, indentation and two themes for the Swan programming language.",
  "version": "0.1.0",
  "publisher": "swan-lang",
  "engines": { "vscode": "^1.60.0" },
  "categories": ["Programming Languages", "Themes"],
  "contributes": {
    "languages": [
      {
        "id": "swan",
        "aliases": ["Swan", "swan"],
        "extensions": [".swan"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "swan",
        "scopeName": "source.swan",
        "path": "./syntaxes/swan.tmLanguage.json"
      }
    ],
    "themes": [
      { "label": "Black Swan", "uiTheme": "vs-dark", "path": "./themes/black-swan.json" },
      { "label": "Swan Lake", "uiTheme": "vs", "path": "./themes/swan-lake.json" }
    ],
    "configurationDefaults": {
      "[swan]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
      }
    }
  }
}
