{
  "name": "Black Swan",
  "type": "dark",
  "colors": {
    "editor.background": "#0E0D12",
    "editor.foreground": "#E6E1EA",
    "editorLineNumber.foreground": "#3A3644",
    "editorLineNumber.activeForeground": "#B9A6D9",
    "editor.lineHighlightBackground": "#17151D",
    "editor.selectionBackground": "#3B2F55",
    "editorCursor.foreground": "#F2C4D6",
    "editorIndentGuide.background1": "#1F1C27",
    "editorIndentGuide.activeBackground1": "#4A4060",
    "editorBracketMatch.border": "#B9A6D9",
    "editorWhitespace.foreground": "#24212C",
    "sideBar.background": "#0B0A0F",
    "activityBar.background": "#0B0A0F",
    "titleBar.activeBackground": "#0B0A0F",
    "statusBar.background": "#0B0A0F",
    "statusBar.foreground": "#8D859C",
    "tab.activeBackground": "#0E0D12",
    "tab.inactiveBackground": "#0B0A0F",
    "editorGroupHeader.tabsBackground": "#0B0A0F",
    "terminal.background": "#0E0D12"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#5E5870", "fontStyle": "italic" } },
    { "scope": "comment.block.documentation", "settings": { "foreground": "#8C80A3", "fontStyle": "italic" } },
    { "scope": "keyword.other.special", "settings": { "foreground": "#F2C4D6", "fontStyle": "bold" } },
    { "scope": "support.type", "settings": { "foreground": "#F2D58A" } },
    { "scope": ["keyword.control", "keyword.other.test"], "settings": { "foreground": "#C7A6F2" } },
    { "scope": ["storage.type", "storage.modifier"], "settings": { "foreground": "#8FB8F7", "fontStyle": "italic" } },
    { "scope": "keyword.operator.word", "settings": { "foreground": "#C7A6F2", "fontStyle": "italic" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#8D859C" } },
    { "scope": ["keyword.operator.pipe", "keyword.operator.arrow"], "settings": { "foreground": "#F2C4D6", "fontStyle": "bold" } },
    { "scope": "keyword.operator.ref", "settings": { "foreground": "#F2A65A", "fontStyle": "bold" } },
    { "scope": "keyword.operator.range", "settings": { "foreground": "#F2C4D6" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#7FD6C2" } },
    { "scope": "entity.name.type", "settings": { "foreground": "#F2D58A" } },
    { "scope": "variable.other.declaration", "settings": { "foreground": "#E6E1EA", "fontStyle": "bold" } },
    { "scope": "variable.other.property", "settings": { "foreground": "#B8C4D9" } },
    { "scope": "variable.language", "settings": { "foreground": "#F2A65A", "fontStyle": "italic" } },
    { "scope": "string", "settings": { "foreground": "#A8D99B" } },
    { "scope": "constant.character.escape", "settings": { "foreground": "#F2D58A" } },
    { "scope": "punctuation.section.interpolation", "settings": { "foreground": "#F2C4D6" } },
    { "scope": "meta.interpolation", "settings": { "foreground": "#E6E1EA" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#F2A65A" } }
  ]
}
