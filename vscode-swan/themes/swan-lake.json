{
  "name": "Swan Lake",
  "type": "light",
  "colors": {
    "editor.background": "#FAF8F4",
    "editor.foreground": "#2E2A36",
    "editorLineNumber.foreground": "#CFC8D6",
    "editorLineNumber.activeForeground": "#6B5A8E",
    "editor.lineHighlightBackground": "#F2EEF6",
    "editor.selectionBackground": "#DCD2EE",
    "editorCursor.foreground": "#6B5A8E",
    "editorIndentGuide.background1": "#ECE7F1",
    "editorIndentGuide.activeBackground1": "#C9BEDB",
    "editorBracketMatch.border": "#6B5A8E",
    "sideBar.background": "#F4F1EC",
    "activityBar.background": "#F4F1EC",
    "titleBar.activeBackground": "#F4F1EC",
    "statusBar.background": "#F4F1EC",
    "statusBar.foreground": "#7A7286",
    "tab.activeBackground": "#FAF8F4",
    "tab.inactiveBackground": "#F4F1EC",
    "editorGroupHeader.tabsBackground": "#F4F1EC",
    "terminal.background": "#FAF8F4"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#A69FB2", "fontStyle": "italic" } },
    { "scope": "comment.block.documentation", "settings": { "foreground": "#8A7AA6", "fontStyle": "italic" } },
    { "scope": "keyword.other.special", "settings": { "foreground": "#C2477A", "fontStyle": "bold" } },
    { "scope": "support.type", "settings": { "foreground": "#A6761D" } },
    { "scope": ["keyword.control", "keyword.other.test"], "settings": { "foreground": "#7B4FB8" } },
    { "scope": ["storage.type", "storage.modifier"], "settings": { "foreground": "#2F6FB5", "fontStyle": "italic" } },
    { "scope": "keyword.operator.word", "settings": { "foreground": "#7B4FB8", "fontStyle": "italic" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#857D92" } },
    { "scope": ["keyword.operator.pipe", "keyword.operator.arrow"], "settings": { "foreground": "#C2477A", "fontStyle": "bold" } },
    { "scope": "keyword.operator.ref", "settings": { "foreground": "#C26A1F", "fontStyle": "bold" } },
    { "scope": "keyword.operator.range", "settings": { "foreground": "#C2477A" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#1D8A73" } },
    { "scope": "entity.name.type", "settings": { "foreground": "#A6761D" } },
    { "scope": "variable.other.declaration", "settings": { "foreground": "#2E2A36", "fontStyle": "bold" } },
    { "scope": "variable.other.property", "settings": { "foreground": "#4F5D75" } },
    { "scope": "variable.language", "settings": { "foreground": "#C26A1F", "fontStyle": "italic" } },
    { "scope": "string", "settings": { "foreground": "#4C8A3A" } },
    { "scope": "constant.character.escape", "settings": { "foreground": "#A6761D" } },
    { "scope": "punctuation.section.interpolation", "settings": { "foreground": "#C2477A" } },
    { "scope": "meta.interpolation", "settings": { "foreground": "#2E2A36" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#C26A1F" } }
  ]
}
